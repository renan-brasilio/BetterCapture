<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>LSUIElement</key>
	<true/>
	<key>NSMicrophoneUsageDescription</key>
	<string>Capster needs access to your microphone to record audio alongside screen captures.</string>
	<key>NSCameraUsageDescription</key>
	<string>Capster needs access to your camera to enable Presenter Overlay during screen recordings.</string>
	<key>NSScreenCaptureUsageDescription</key>
	<string>Capster needs access to screen recording to capture your screen content.</string>
	<key>SUFeedURL</key>
	<string>https://github.com/renan-brasilio/BetterCapture/releases/latest/download/appcast.xml</string>
	<key>SUPublicEDKey</key>
	<string>SPARKLE_PUBLIC_KEY</string>
	<key>SUEnableInstallerLauncherService</key>
	<true/>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.renanfamous.Capster</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>capster</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
